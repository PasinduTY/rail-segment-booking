# Copy this file to .env before running `docker compose up`.
# .env is git-ignored - never commit real credentials.
#
# POSTGRES_PASSWORD: pick ANY value - there is nothing to look up. This is a
# brand-new Postgres container being created for the first time, not a
# connection to an existing database, so whatever you put here is simply
# what it gets initialized with. docker-compose.yml feeds this exact same
# value into both the postgres container and the API's connection string
# automatically, so there is nothing to keep in sync manually.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=railbooking
